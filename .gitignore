# ── Secrets (NEVER commit) ───────────────────────────────
.env
**/.env
backend/.env

# ── Python / backend ─────────────────────────────────────
**/.venv/
**/__pycache__/
*.pyc
backend/.eia_cache.json
backend/.bh_cache/
backend/.news_store.json
# Runtime caches written by the app (regenerated on demand)
backend/data/
# SQLite WAL/shm sidecars (transient — regenerated at runtime)
*.db-wal
*.db-shm

# ── Node / frontend ──────────────────────────────────────
**/node_modules/
**/dist/
**/dist-ssr/
*.local

# ── Editor / OS ──────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log

# ── Agent / local tooling ────────────────────────────────
.claude/

# ── Stray output files ───────────────────────────────────
/killing
/nothing

# ── Large raw data & archives (NEVER commit — multi-GB) ──
# Raw 1-min/15-min CSV feeds live in the canonical OneDrive\Regime\data; the repo
# only needs the small trained-model parquets + the backend cache parquets.
/data/
*.zip
*.tar.gz
*.tgz

# ── Regime model project: keep ONLY the trained model ────
# Regime/ is a working copy of the model project. Commit the trained model
# artifacts (model/cache parquets, pipeline.py); ignore its bulky raw data,
# notebooks, dev strategy copy and booklets.
/Regime/*
!/Regime/model
/Regime/model/__pycache__/
/Regime/model/cache/__pycache__/

# ── Local research tooling (not part of the app) ─────────
# research/ = inventory-impact (was rough_work) + spread-models (was analysis).
# Local analysis IP; the production versions live in backend/app. Kept out of the
# repo like the old /analysis/ rule. Flip to committed by removing this line.
/research/
