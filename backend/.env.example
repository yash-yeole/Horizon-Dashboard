# Copy to .env to override defaults. All vars are optional.
HORIZON_CACHE_TTL=20
HORIZON_REQUEST_TIMEOUT=15
# Comma-separated list is not supported here; edit app/config.py for CORS origins

# EIA Open Data API key (free): https://www.eia.gov/opendata/register.php
# Required for live inventory/storage data on the Inventories page + Dashboard.
HORIZON_EIA_API_KEY=
HORIZON_EIA_CACHE_TTL=3600

# aisstream.io API key (free, GitHub sign-in): https://aisstream.io
# Powers the live tanker map on the Freight page. Without it the map shows an
# "AIS offline" state.
HORIZON_AISSTREAM_API_KEY=
