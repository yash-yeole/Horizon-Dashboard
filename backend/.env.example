# Copy to .env to override defaults. All vars are optional.
HORIZON_CACHE_TTL=20
HORIZON_REQUEST_TIMEOUT=15
# Comma-separated list is not supported here; edit app/config.py for CORS origins

# EIA Open Data API key (free): https://www.eia.gov/opendata/register.php
# Required for live inventory/storage data on the Inventories page + Dashboard.
HORIZON_EIA_API_KEY=
HORIZON_EIA_CACHE_TTL=3600

# aisstream.io API key (free, GitHub sign-in): https://aisstream.io
# Powers the live tanker map on the Freight page. Without it the map shows an
# "AIS offline" state.
HORIZON_AISSTREAM_API_KEY=

# FinBERT news sentiment (local, ProsusAI/finbert) — NO API KEY REQUIRED.
# It runs on CPU inside the backend (deps: torch + transformers, in
# requirements.txt). Set to false to fall back to the offline keyword lexicon.
HORIZON_FINBERT_ENABLED=true
# Optional: swap the model (any HF text-classification finance model works).
HORIZON_FINBERT_MODEL=ProsusAI/finbert
#
# (If you ever switch to Hugging Face's *hosted* Inference API instead of local
#  inference, this is where an HF token would go — e.g. HORIZON_HF_API_KEY=...)

# ── Inventory consensus / surprise (EIA event-study model) ────────
# Powers the "expected vs actual" surprise that drives the inventory-impact
# model. Both sources are FREE and KEYLESS — NO API KEY REQUIRED:
#   * Investing.com economic-calendar pages embed historical
#     actual/forecast/previous JSON (event 75 = EIA Crude Oil Inventories,
#     959 = Gasoline, 829 = Cushing). Keyless page fetch.
#   * ForexFactory weekly JSON (nfs.faireconomy.media/ff_calendar_thisweek.json)
#     carries the upcoming week's consensus. Keyless.
# (TradingEconomics is intentionally NOT used — its API is paid and its free
#  guest tier was discontinued. We rely only on the two free sources above.)

# ── Paper-trading bar source (strategy/data_feed.py) ─────────────
# NOTE: read directly by data_feed.py via os.environ — it is NOT HORIZON_-prefixed.
# Folder of bars_15min_*.db files. If unset, the feed auto-picks the live network
# share (I:\Public\Summer Interns Energy\DB) when reachable, else the bundled local
# copy at backend/strategy/files/. Set this to pin a specific location:
# REGIME_DATA_DIR=I:\Public\Summer Interns Energy\DB
#
# ── Forward-curve snapshots ──────────────────────────────────────
# Brent + Gas Oil curves read committed daily-settle snapshots in backend/curves/
# (ICE — not on Yahoo). WTI/Heating Oil/RBOB are live from Yahoo. Regenerate the
# snapshots from the raw 1-min Regime/data feeds with:  python backend/refresh_curves.py
